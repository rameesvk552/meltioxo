PORT=5000
NODE_ENV=development
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=perfume_erp_dev
JWT_SECRET=your_jwt_secret_here

# Marketing OS partner integration (same contract used by Travel Bot)
MARKETING_OS_PARTNER_API_BASE_URL=http://127.0.0.1:8000/api/v1
MARKETING_OS_PARTNER_API_KEY=your_marketing_os_partner_api_key
MARKETING_OS_SESSION_SECRET=replace_with_a_long_random_secret
MARKETING_OS_TIMEOUT_MS=20000

# Each company saves its own encrypted WhatsApp API token in Company Settings.
# This key encrypts those database values; keep it private and stable.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_long_random_credential_key
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TIMEOUT_MS=15000

# WhatsApp receives a signed PDF URL that expires after ten minutes. This is
# shared server configuration, not a per-company setting.
INVOICE_PUBLIC_BASE_URL=https://perfume.wayon.in
INVOICE_LINK_SECRET=replace_with_a_long_random_invoice_link_secret
INVOICE_LINK_TTL_SECONDS=600
